		"How the cart total calculation works": {
			"name": "How the cart total calculation works",
			"simSteps": [],
			"description": "<ul><li>The application provides users with a running total of the cost of their selected items</li><li>- The total cost is calculated by summing the prices of all items in the cart, multiplied by their respective quantities</li><li>- React's <code>useMemo</code> hook is used to efficiently recalculate the total only when the cart's contents change</li><li>- The final calculated total is formatted as a price string (e</li><li>g</li><li>, '$56</li><li>00') and displayed prominently below the cart items</li></ul>",
			"simulationNodesAndEdges": {},
			"isAIGenerated": true,
			"keywords": "total, useMemo, reduce, price, qty, formatPrice",
			"generationPrompt": "How the cart total calculation works",
			"generationKeywords": "total, useMemo, reduce, price, qty, formatPrice"
		},
		"How removing items from the cart works": {
			"name": "How removing items from the cart works",
			"simSteps": [],
			"description": "<ul><li>This feature allows users to adjust their cart by removing items one by one</li><li>- Each item listed in the cart has a Remove one button</li><li>- Clicking this button calls the <code>removeFromCart</code> function, which decreases the item's quantity by one</li><li>- If an item's quantity becomes zero after the decrease, it is completely removed from the cart using a <code>filter</code> operation</li><li>- The cart display and the total price are updated immediately to reflect the change</li></ul>",
			"simulationNodesAndEdges": {},
			"isAIGenerated": true,
			"keywords": "removeFromCart, setCart, filter, qty, item.product.id, Remove one",
			"generationPrompt": "How removing items from the cart works",
			"generationKeywords": "removeFromCart, setCart, filter, qty, item.product.id, Remove one"
		},
		"How item quantity modification in the cart works": {
			"name": "How item quantity modification in the cart works",
			"simSteps": [],
			"description": "<ul><li>Users can easily modify the quantity of items directly from the cart view</li><li>- The cart provides an Add one and Remove one button for each item</li><li>- Add one re-uses the <code>addToCart</code> logic to increment the quantity of an existing item</li><li>- Remove one uses the <code>removeFromCart</code> logic to decrement the quantity</li><li>- This provides fine-grained control over the cart's contents without having to find the product again in the main catalog</li></ul>",
			"simulationNodesAndEdges": {},
			"isAIGenerated": true,
			"keywords": "addToCart, removeFromCart, qty, Add one, Remove one, existing",
			"generationPrompt": "How item quantity modification in the cart works",
			"generationKeywords": "addToCart, removeFromCart, qty, Add one, Remove one, existing"
		},
		"How clearing the entire cart works": {
			"name": "How clearing the entire cart works",
			"simSteps": [],
			"description": "<ul><li>This provides a quick way for users to empty their shopping cart and start over</li><li>- A Clear cart button is visible whenever there is at least one item in the cart</li><li>- When clicked, the <code>clearCart</code> function is executed</li><li>- This function resets the cart's state to an empty array (<code></code>)</li><li>- The cart display immediately updates to show the Your cart is empty</li><li>message</li></ul>",
			"simulationNodesAndEdges": {},
			"isAIGenerated": true,
			"keywords": "clearCart, setCart, onClick, Clear cart, cart.length",
